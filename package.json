{
  "name": "all-things-water",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "All Things Water \u2014 standalone storefront for bottled water, coolers & dispensers. Forked from water-filter-company. DO NOT MERGE INTO master.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "bash scripts/test-db.sh",
    "typecheck": "tsc -b --noEmit",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:ui": "playwright test --ui",
    "generate-sitemap": "npx tsx scripts/generate-sitemap.ts > public/sitemap.xml",
    "deno:check": "cd supabase/functions && deno check **/*.ts",
    "deno:test": "cd supabase/functions && deno test --allow-env --allow-net _shared/payfast.test.ts _shared/payfast-ip.test.ts _shared/subscription.test.ts _shared/turnstile.test.ts _shared/payfast-api.test.ts _shared/slo.test.ts _shared/http.test.ts _shared/order-validation.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "lucide-react": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.1.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "minimatch@3": {
      "brace-expansion": "^1.1.21"
    },
    "postcss-selector-parser": "^7.1.6"
  },
  "engines": {
    "node": ">=22"
  }
}
